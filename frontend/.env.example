# Frontend environment variables (copy to .env.local for local overrides).

# Dev only: where the Vite dev server proxies /auth and /api.
# Defaults to http://localhost:8080 if unset.
VITE_API_TARGET=http://localhost:8080

# Production: absolute base URL of the deployed backend API.
# Leave EMPTY for local dev (requests stay relative and use the Vite proxy).
# In production set this to your deployed backend, e.g. https://api.yourdomain.com
VITE_API_BASE_URL=
