{
  "name": "groundwork",
  "install": "npm ci",
  "terminals": [
    {
      "name": "api",
      "command": "npm run dev:api",
      "description": "Express API server on http://localhost:3001"
    },
    {
      "name": "web",
      "command": "npm run dev:web",
      "description": "Vite dev server (React client) on http://localhost:5173, proxies /api to the API"
    }
  ],
  "ports": [
    { "name": "web", "port": 5173 },
    { "name": "api", "port": 3001 }
  ]
}
